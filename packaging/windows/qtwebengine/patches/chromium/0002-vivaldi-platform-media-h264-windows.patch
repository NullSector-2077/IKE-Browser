+#define LOG_HR_FAIL(hr, message)                                       \
+  do {                                                                 \
+    VLOG(1) << " PROPMEDIA(RENDERER) : " << __FUNCTION__ << " Failed " \
+            << message << ", hr=0x" << std::hex << hr;                 \
+  } while (false)
+
+#define RETURN_ON_HR_FAIL(hr, message, return_value) \
+  do {                                               \
+    HRESULT _hr_value = (hr);                        \
+    if (FAILED(_hr_value)) {                         \
+      LOG_HR_FAIL(_hr_value, message);               \
+      return (return_value);                         \
+    }                                                \
+  } while (false)
