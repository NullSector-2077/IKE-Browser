+// Copyright 2026 The I.K.E. Browser authors
+// SPDX-License-Identifier: BSD-3-Clause
+//
+// Part of I.K.E.'s Windows patch set for Qt WebEngine; not upstream Chromium.
+
+#ifndef MEDIA_FILTERS_WIN_MEDIA_FOUNDATION_VIDEO_DECODER_H_
+#define MEDIA_FILTERS_WIN_MEDIA_FOUNDATION_VIDEO_DECODER_H_
+
+#include <mfidl.h>
+#include <wrl/client.h>
+
+#include <memory>
+
+#include "base/functional/callback.h"
+#include "base/sequence_checker.h"
+#include "media/base/media_export.h"
+#include "media/base/media_log.h"
+#include "media/base/video_decoder.h"
+#include "media/base/video_decoder_config.h"
+#include "media/base/video_frame_pool.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace media {
+
+// Decodes H.264 with the decoder that is part of Windows (the Media Foundation
+// transform CLSID_CMSH264DecoderMFT in msmpeg2vdec.dll), in software, in the
+// process that plays the video. The engine contains no H.264 decoder of its
+// own: without that Windows component this class fails to initialise and
+// H.264 is reported as not supported.
+//
+// It is the last entry in the default decoder list. A computer whose graphics
+// driver decodes H.264 normally uses D3D11VideoDecoder; this class serves the
+// others (no usable GPU decoder, software rendering, virtual machines) and
+// small videos, for which Chromium prefers a software decoder.
+//
+// The idea of driving the Windows transform from a media::VideoDecoder comes
+// from the "platform_media" code of Opera and Vivaldi (BSD licence); this is
+// an independent implementation.
+class MEDIA_EXPORT MediaFoundationVideoDecoder : public VideoDecoder {
+ public:
+  explicit MediaFoundationVideoDecoder(std::unique_ptr<MediaLog> media_log);
+
+  MediaFoundationVideoDecoder(const MediaFoundationVideoDecoder&) = delete;
+  MediaFoundationVideoDecoder& operator=(const MediaFoundationVideoDecoder&) =
+      delete;
+
+  ~MediaFoundationVideoDecoder() override;
+
+  // VideoDecoder implementation.
+  VideoDecoderType GetDecoderType() const override;
+  void Initialize(const VideoDecoderConfig& config,
+                  bool low_delay,
+                  CdmContext* cdm_context,
+                  InitCB init_cb,
+                  const OutputCB& output_cb,
+                  const WaitingCB& waiting_cb) override;
+  void Decode(scoped_refptr<DecoderBuffer> buffer, DecodeCB decode_cb) override;
+  void Reset(base::OnceClosure closure) override;
+  bool NeedsBitstreamConversion() const override;
+
+ private:
+  // How the transform lays out one decoded picture in its output buffer.
+  struct OutputLayout {
+    // Size of the picture as the transform reports it.
+    gfx::Size size;
+    // Part of the picture that is shown.
+    gfx::Rect visible_rect;
+    // Bytes per row of the luma plane, as the transform reports it.
+    int stride = 0;
+  };
+
+  enum class OutputResult { kFrame, kNeedMoreInput, kFormatChanged, kError };
+
+  bool CreateTransform(const VideoDecoderConfig& config, bool low_delay);
+  bool ConfigureOutput();
+  bool DecodeBuffer(const DecoderBuffer& buffer);
+  bool Drain();
+  // Hands every picture the transform has ready to |output_cb_|.
+  bool PumpOutput();
+  OutputResult ProcessOneOutput();
+  bool DeliverFrame(IMFSample* sample);
+
+  std::unique_ptr<MediaLog> media_log_;
+
+  VideoDecoderConfig config_;
+  OutputCB output_cb_;
+
+  Microsoft::WRL::ComPtr<IMFTransform> transform_;
+  // Buffer the transform decodes into. Null when the transform allocates its
+  // own samples.
+  Microsoft::WRL::ComPtr<IMFSample> output_sample_;
+  OutputLayout layout_;
+
+  VideoFramePool frame_pool_;
+
+  bool has_error_ = false;
+  bool logged_first_frame_ = false;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+}  // namespace media
+
+#endif  // MEDIA_FILTERS_WIN_MEDIA_FOUNDATION_VIDEO_DECODER_H_
