+// CLSID_CMSH264DecoderMFT: the H.264 decoder that is part of Windows.
+constexpr GUID kWindowsH264DecoderClsid = {
+    0x62ce7e72,
+    0x4c71,
+    0x4d20,
+    {0xb1, 0x5d, 0x45, 0x28, 0x31, 0xa8, 0x7d, 0x9d}};
+
+// CODECAPI_AVLowLatencyMode: asks the decoder not to hold pictures back.
+constexpr GUID kLowLatencyModeAttribute = {
+    0x9c27891a,
+    0xed7a,
+    0x40e1,
+    {0x88, 0xe8, 0xb2, 0x27, 0x27, 0xa0, 0x24, 0xee}};
+
+constexpr DWORD kStreamId = 0;
+
+// Largest picture the Windows decoder accepts in software.
+constexpr int kMaxCodedWidth = 4096;
+constexpr int kMaxCodedHeight = 2304;
+
+// The transform is not asked to decode more than this many times in a row
+// without progress; a guard against a decoder that never settles.
+constexpr int kMaxOutputRounds = 64;
+
+bool IsSupportedProfile(VideoCodecProfile profile) {
+  switch (profile) {
+    case H264PROFILE_BASELINE:
+    case H264PROFILE_MAIN:
+    case H264PROFILE_EXTENDED:
+    case H264PROFILE_HIGH:
+      return true;
+    default:
+      return false;
+  }
+}
+
+int RoundUpTo16(int value) {
+  return (value + 15) & ~15;
+}
+
+using DllGetClassObjectFunction = HRESULT(STDAPICALLTYPE*)(REFCLSID,
+                                                           REFIID,
+                                                           LPVOID*);
+
+// Creates the Windows H.264 decoder straight from its library. The usual way
+// (CoCreateInstance, MFTEnumEx) reads the registry, which a sandboxed process
+// is not allowed to do.
+Microsoft::WRL::ComPtr<IMFTransform> CreateWindowsH264Decoder() {
+  HMODULE library = GetMediaFoundationH264DecoderLibrary();
+  if (!library) {
+    return nullptr;
+  }
+
+  auto get_class_object = reinterpret_cast<DllGetClassObjectFunction>(
+      ::GetProcAddress(library, "DllGetClassObject"));
+  if (!get_class_object) {
+    return nullptr;
+  }
+
+  Microsoft::WRL::ComPtr<IClassFactory> factory;
+  HRESULT hr =
+      get_class_object(kWindowsH264DecoderClsid, IID_PPV_ARGS(&factory));
+  if (FAILED(hr) || !factory) {
+    DVLOG(1) << "No class factory for the Windows H.264 decoder: "
+             << PrintHr(hr);
+    return nullptr;
+  }
+
+  Microsoft::WRL::ComPtr<IMFTransform> transform;
+  hr = factory->CreateInstance(nullptr, IID_PPV_ARGS(&transform));
+  if (FAILED(hr) || !transform) {
+    DVLOG(1) << "Could not create the Windows H.264 decoder: " << PrintHr(hr);
+    return nullptr;
+  }
+  return transform;
+}
+
+// Reads the shown part of the picture from |type|, if it says.
+bool GetDisplayAperture(IMFMediaType* type, gfx::Rect* aperture) {
+  MFVideoArea area = {};
+  UINT32 size = 0;
+  HRESULT hr = type->GetBlob(MF_MT_MINIMUM_DISPLAY_APERTURE,
+                             reinterpret_cast<UINT8*>(&area), sizeof(area),
+                             &size);
+  if (FAILED(hr) || size != sizeof(area)) {
+    return false;
+  }
+  *aperture = gfx::Rect(area.OffsetX.value, area.OffsetY.value, area.Area.cx,
+                        area.Area.cy);
+  return !aperture->IsEmpty();
+}
+
+gfx::ColorSpace GuessColorSpace(const VideoDecoderConfig& config,
+                                const gfx::Size& size) {
+  if (config.color_space_info().IsSpecified()) {
+    gfx::ColorSpace color_space = config.color_space_info().ToGfxColorSpace();
+    if (color_space.IsValid()) {
+      return color_space;
+    }
+  }
+  // The usual convention when a stream does not say: BT.601 for standard
+  // definition, BT.709 above it.
+  return size.height() < 720 ? gfx::ColorSpace::CreateREC601()
+                             : gfx::ColorSpace::CreateREC709();
+}
