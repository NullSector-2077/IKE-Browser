+MediaFoundationVideoDecoder::MediaFoundationVideoDecoder(
+    std::unique_ptr<MediaLog> media_log)
+    : media_log_(std::move(media_log)) {
+  DETACH_FROM_SEQUENCE(sequence_checker_);
+}
+
+MediaFoundationVideoDecoder::~MediaFoundationVideoDecoder() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+}
+
+VideoDecoderType MediaFoundationVideoDecoder::GetDecoderType() const {
+  return VideoDecoderType::kMediaFoundation;
+}
+
+bool MediaFoundationVideoDecoder::NeedsBitstreamConversion() const {
+  // The Windows decoder takes an Annex B stream: start codes, with the
+  // parameter sets inside the stream.
+  return true;
+}
+
+void MediaFoundationVideoDecoder::Initialize(const VideoDecoderConfig& config,
+                                             bool low_delay,
+                                             CdmContext* /* cdm_context */,
+                                             InitCB init_cb,
+                                             const OutputCB& output_cb,
+                                             const WaitingCB& /* waiting_cb */) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(output_cb);
+
+  InitCB bound_init_cb = base::BindPostTaskToCurrentDefault(std::move(init_cb));
+
+  // A new Initialize() replaces whatever was being decoded.
+  transform_.Reset();
+  output_sample_.Reset();
+  layout_ = OutputLayout();
+  has_error_ = false;
+  logged_first_frame_ = false;
+
+  if (config.is_encrypted()) {
+    std::move(bound_init_cb)
+        .Run(DecoderStatus::Codes::kUnsupportedEncryptionMode);
+    return;
+  }
+
+  if (config.codec() != VideoCodec::kH264) {
+    std::move(bound_init_cb).Run(DecoderStatus::Codes::kUnsupportedCodec);
+    return;
+  }
+
+  if (!IsSupportedProfile(config.profile())) {
+    std::move(bound_init_cb).Run(DecoderStatus::Codes::kUnsupportedProfile);
+    return;
+  }
+
+  const gfx::Size& coded_size = config.coded_size();
+  if (coded_size.IsEmpty() || coded_size.width() > kMaxCodedWidth ||
+      coded_size.height() > kMaxCodedHeight) {
+    std::move(bound_init_cb).Run(DecoderStatus::Codes::kUnsupportedConfig);
+    return;
+  }
+
+  // ConfigureOutput() reads |config_|.
+  config_ = config;
+  output_cb_ = output_cb;
+
+  if (!CreateTransform(config, low_delay)) {
+    transform_.Reset();
+    output_sample_.Reset();
+    MEDIA_LOG(INFO, media_log_)
+        << "MediaFoundationVideoDecoder: the H.264 decoder of Windows is not "
+           "available or refused this stream";
+    std::move(bound_init_cb).Run(DecoderStatus::Codes::kFailedToCreateDecoder);
+    return;
+  }
+
+  MEDIA_LOG(INFO, media_log_)
+      << "MediaFoundationVideoDecoder: decoding H.264 with the software "
+         "decoder of Windows (Media Foundation)";
+  std::move(bound_init_cb).Run(DecoderStatus::Codes::kOk);
+}
+
+void MediaFoundationVideoDecoder::Decode(scoped_refptr<DecoderBuffer> buffer,
+                                         DecodeCB decode_cb) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  DCHECK(buffer);
+  DCHECK(decode_cb);
+
+  DecodeCB bound_decode_cb =
+      base::BindPostTaskToCurrentDefault(std::move(decode_cb));
+
+  if (!transform_) {
+    std::move(bound_decode_cb).Run(DecoderStatus::Codes::kNotInitialized);
+    return;
+  }
+
+  if (has_error_) {
+    std::move(bound_decode_cb).Run(DecoderStatus::Codes::kPlatformDecodeFailure);
+    return;
+  }
+
+  const bool ok = buffer->end_of_stream() ? Drain() : DecodeBuffer(*buffer);
+  if (!ok) {
+    has_error_ = true;
+    std::move(bound_decode_cb).Run(DecoderStatus::Codes::kPlatformDecodeFailure);
+    return;
+  }
+
+  std::move(bound_decode_cb).Run(DecoderStatus::Codes::kOk);
+}
+
+void MediaFoundationVideoDecoder::Reset(base::OnceClosure closure) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  if (transform_) {
+    // Drops the pictures the decoder still holds; playback continues from the
+    // next key frame, as after a seek.
+    HRESULT hr = transform_->ProcessMessage(MFT_MESSAGE_COMMAND_FLUSH, 0);
+    if (FAILED(hr)) {
+      DVLOG(1) << "Flushing the Windows H.264 decoder failed: " << PrintHr(hr);
+    }
+  }
+
+  // Never run |closure| before Reset() returns.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                           std::move(closure));
+}
+
+bool MediaFoundationVideoDecoder::CreateTransform(
+    const VideoDecoderConfig& config,
+    bool low_delay) {
+  transform_ = CreateWindowsH264Decoder();
+  if (!transform_) {
+    return false;
+  }
+
+  if (low_delay) {
+    Microsoft::WRL::ComPtr<IMFAttributes> attributes;
+    if (SUCCEEDED(transform_->GetAttributes(&attributes)) && attributes) {
+      // Best effort: an older decoder ignores it.
+      attributes->SetUINT32(kLowLatencyModeAttribute, TRUE);
+    }
+  }
+
+  Microsoft::WRL::ComPtr<IMFMediaType> input_type;
+  HRESULT hr = MFCreateMediaType(&input_type);
+  RETURN_ON_HR_FAILURE(hr, "MFCreateMediaType failed", false);
+  hr = input_type->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Video);
+  RETURN_ON_HR_FAILURE(hr, "Setting the major type failed", false);
+  hr = input_type->SetGUID(MF_MT_SUBTYPE, MFVideoFormat_H264);
+  RETURN_ON_HR_FAILURE(hr, "Setting the subtype failed", false);
+  hr = input_type->SetUINT32(MF_MT_INTERLACE_MODE,
+                             MFVideoInterlace_MixedInterlaceOrProgressive);
+  RETURN_ON_HR_FAILURE(hr, "Setting the interlace mode failed", false);
+  hr = MFSetAttributeSize(input_type.Get(), MF_MT_FRAME_SIZE,
+                          static_cast<UINT32>(config.coded_size().width()),
+                          static_cast<UINT32>(config.coded_size().height()));
+  RETURN_ON_HR_FAILURE(hr, "Setting the frame size failed", false);
+
+  hr = transform_->SetInputType(kStreamId, input_type.Get(), 0);
+  RETURN_ON_HR_FAILURE(hr, "The Windows H.264 decoder refused the input type",
+                       false);
+
+  if (!ConfigureOutput()) {
+    return false;
+  }
+
+  // Both are optional for this decoder; failures are not errors.
+  transform_->ProcessMessage(MFT_MESSAGE_NOTIFY_BEGIN_STREAMING, 0);
+  transform_->ProcessMessage(MFT_MESSAGE_NOTIFY_START_OF_STREAM, 0);
+  return true;
+}
+
+bool MediaFoundationVideoDecoder::ConfigureOutput() {
+  // Ask for YV12: three separate planes in ordinary memory, which is what a
+  // software video frame in Chromium is.
+  Microsoft::WRL::ComPtr<IMFMediaType> output_type;
+  for (DWORD index = 0;; ++index) {
+    output_type.Reset();
+    HRESULT hr =
+        transform_->GetOutputAvailableType(kStreamId, index, &output_type);
+    RETURN_ON_HR_FAILURE(hr, "The Windows H.264 decoder offers no YV12 output",
+                         false);
+    GUID subtype = GUID_NULL;
+    if (SUCCEEDED(output_type->GetGUID(MF_MT_SUBTYPE, &subtype)) &&
+        subtype == MFVideoFormat_YV12) {
+      break;
+    }
+  }
+
+  HRESULT hr = transform_->SetOutputType(kStreamId, output_type.Get(), 0);
+  RETURN_ON_HR_FAILURE(hr, "Setting the output type failed", false);
+
+  UINT32 width = 0;
+  UINT32 height = 0;
+  hr = MFGetAttributeSize(output_type.Get(), MF_MT_FRAME_SIZE, &width, &height);
+  RETURN_ON_HR_FAILURE(hr, "The output type has no frame size", false);
+  if (width == 0 || height == 0 || width > 2 * kMaxCodedWidth ||
+      height > 2 * kMaxCodedHeight) {
+    LOG(ERROR) << "Unusable output size from the Windows H.264 decoder: "
+               << width << "x" << height;
+    return false;
+  }
+
+  OutputLayout layout;
+  layout.size = gfx::Size(static_cast<int>(width), static_cast<int>(height));
+
+  UINT32 default_stride = 0;
+  if (SUCCEEDED(output_type->GetUINT32(MF_MT_DEFAULT_STRIDE, &default_stride)) &&
+      static_cast<int32_t>(default_stride) >= layout.size.width() &&
+      static_cast<int32_t>(default_stride) <= 4 * kMaxCodedWidth) {
+    layout.stride = static_cast<int>(default_stride);
+  } else {
+    layout.stride = layout.size.width();
+  }
+
+  const gfx::Rect full_rect(layout.size);
+  gfx::Rect aperture;
+  if (GetDisplayAperture(output_type.Get(), &aperture) &&
+      full_rect.Contains(aperture)) {
+    layout.visible_rect = aperture;
+  } else if (full_rect.Contains(config_.visible_rect()) &&
+             !config_.visible_rect().IsEmpty()) {
+    layout.visible_rect = config_.visible_rect();
+  } else {
+    layout.visible_rect = full_rect;
+  }
+  layout_ = layout;
+
+  MFT_OUTPUT_STREAM_INFO stream_info = {};
+  hr = transform_->GetOutputStreamInfo(kStreamId, &stream_info);
+  RETURN_ON_HR_FAILURE(hr, "GetOutputStreamInfo failed", false);
+
+  output_sample_.Reset();
+  const bool transform_allocates =
+      (stream_info.dwFlags & (MFT_OUTPUT_STREAM_PROVIDES_SAMPLES |
+                              MFT_OUTPUT_STREAM_CAN_PROVIDE_SAMPLES)) != 0;
+  if (!transform_allocates) {
+    if (stream_info.cbSize == 0) {
+      LOG(ERROR) << "The Windows H.264 decoder reports an empty output buffer";
+      return false;
+    }
+    output_sample_ = CreateEmptySampleWithBuffer(
+        stream_info.cbSize, static_cast<int>(stream_info.cbAlignment));
+    if (!output_sample_) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool MediaFoundationVideoDecoder::DecodeBuffer(const DecoderBuffer& buffer) {
+  const uint8_t* input_data = buffer.data();
+  const size_t input_size = buffer.size();
+  if (!input_data || input_size == 0) {
+    return true;
+  }
+
+  Microsoft::WRL::ComPtr<IMFSample> sample =
+      CreateEmptySampleWithBuffer(static_cast<uint32_t>(input_size), 0);
+  if (!sample) {
+    return false;
+  }
+
+  Microsoft::WRL::ComPtr<IMFMediaBuffer> media_buffer;
+  HRESULT hr = sample->GetBufferByIndex(0, &media_buffer);
+  RETURN_ON_HR_FAILURE(hr, "GetBufferByIndex failed", false);
+
+  uint8_t* destination = nullptr;
+  DWORD max_length = 0;
+  hr = media_buffer->Lock(&destination, &max_length, nullptr);
+  RETURN_ON_HR_FAILURE(hr, "Locking the input buffer failed", false);
+  const bool fits = destination && input_size <= max_length;
+  if (fits) {
+    memcpy(destination, input_data, input_size);
+  }
+  media_buffer->Unlock();
+  if (!fits) {
+    return false;
+  }
+
+  hr = media_buffer->SetCurrentLength(static_cast<DWORD>(input_size));
+  RETURN_ON_HR_FAILURE(hr, "SetCurrentLength failed", false);
+
+  // Media Foundation counts time in units of 100 nanoseconds.
+  hr = sample->SetSampleTime(buffer.timestamp().InMicroseconds() * 10);
+  RETURN_ON_HR_FAILURE(hr, "SetSampleTime failed", false);
+  if (buffer.duration().is_positive()) {
+    sample->SetSampleDuration(buffer.duration().InMicroseconds() * 10);
+  }
+
+  hr = transform_->ProcessInput(kStreamId, sample.Get(), 0);
+  if (hr == MF_E_NOTACCEPTING) {
+    // The decoder wants its finished pictures collected first.
+    if (!PumpOutput()) {
+      return false;
+    }
+    hr = transform_->ProcessInput(kStreamId, sample.Get(), 0);
+  }
+  RETURN_ON_HR_FAILURE(hr, "The Windows H.264 decoder rejected the input",
+                       false);
+
+  return PumpOutput();
+}
+
+bool MediaFoundationVideoDecoder::Drain() {
+  HRESULT hr = transform_->ProcessMessage(MFT_MESSAGE_COMMAND_DRAIN, 0);
+  RETURN_ON_HR_FAILURE(hr, "Draining the Windows H.264 decoder failed", false);
+  return PumpOutput();
+}
+
+bool MediaFoundationVideoDecoder::PumpOutput() {
+  int format_changes = 0;
+  for (;;) {
+    switch (ProcessOneOutput()) {
+      case OutputResult::kFrame:
+        break;
+      case OutputResult::kNeedMoreInput:
+        return true;
+      case OutputResult::kFormatChanged:
+        if (++format_changes > kMaxOutputRounds) {
+          return false;
+        }
+        break;
+      case OutputResult::kError:
+        return false;
+    }
+  }
+}
+
+MediaFoundationVideoDecoder::OutputResult
+MediaFoundationVideoDecoder::ProcessOneOutput() {
+  MFT_OUTPUT_DATA_BUFFER output = {};
+  output.dwStreamID = kStreamId;
+  output.pSample = output_sample_.Get();
+
+  DWORD status = 0;
+  HRESULT hr = transform_->ProcessOutput(0, 1, &output, &status);
+
+  if (output.pEvents) {
+    output.pEvents->Release();
+    output.pEvents = nullptr;
+  }
+
+  // When the transform allocates the sample, the reference is ours to drop.
+  Microsoft::WRL::ComPtr<IMFSample> transform_sample;
+  if (!output_sample_ && output.pSample) {
+    transform_sample.Attach(output.pSample);
+  }
+
+  if (hr == MF_E_TRANSFORM_NEED_MORE_INPUT) {
+    return OutputResult::kNeedMoreInput;
+  }
+
+  if (hr == MF_E_TRANSFORM_STREAM_CHANGE) {
+    // The decoder has read the stream's real picture size; negotiate again.
+    return ConfigureOutput() ? OutputResult::kFormatChanged
+                             : OutputResult::kError;
+  }
+
+  RETURN_ON_HR_FAILURE(hr, "The Windows H.264 decoder failed to decode",
+                       OutputResult::kError);
+
+  IMFSample* sample = output.pSample;
+  if (!sample) {
+    return OutputResult::kError;
+  }
+
+  const bool delivered = DeliverFrame(sample);
+
+  if (output_sample_) {
+    // Make our buffer ready for the next picture.
+    Microsoft::WRL::ComPtr<IMFMediaBuffer> media_buffer;
+    if (SUCCEEDED(output_sample_->GetBufferByIndex(0, &media_buffer))) {
+      media_buffer->SetCurrentLength(0);
+    }
+  }
+
+  return delivered ? OutputResult::kFrame : OutputResult::kError;
+}
+
+bool MediaFoundationVideoDecoder::DeliverFrame(IMFSample* sample) {
+  LONGLONG sample_time = 0;
+  HRESULT hr = sample->GetSampleTime(&sample_time);
+  RETURN_ON_HR_FAILURE(hr, "The decoded picture has no time", false);
+  const base::TimeDelta timestamp = base::Microseconds(sample_time / 10);
+
+  Microsoft::WRL::ComPtr<IMFMediaBuffer> media_buffer;
+  hr = sample->ConvertToContiguousBuffer(&media_buffer);
+  RETURN_ON_HR_FAILURE(hr, "ConvertToContiguousBuffer failed", false);
+
+  const int width = layout_.size.width();
+  const int height = layout_.size.height();
+  const int chroma_width = (width + 1) / 2;
+  const int chroma_height = (height + 1) / 2;
+
+  scoped_refptr<VideoFrame> frame = frame_pool_.CreateFrame(
+      PIXEL_FORMAT_I420, layout_.size, layout_.visible_rect,
+      config_.aspect_ratio().GetNaturalSize(layout_.visible_rect), timestamp);
+  if (!frame) {
+    LOG(ERROR) << "Could not allocate a video frame of "
+               << layout_.size.ToString();
+    return false;
+  }
+
+  uint8_t* data = nullptr;
+  DWORD data_size = 0;
+  hr = media_buffer->Lock(&data, nullptr, &data_size);
+  RETURN_ON_HR_FAILURE(hr, "Locking the decoded picture failed", false);
+
+  // The buffer holds the Y plane, then V, then U (YV12). The decoder pads the
+  // rows, and on some streams the height, to a multiple of 16. Its exact
+  // layout is found by matching the candidates against the buffer's length,
+  // so nothing is ever read past the end of the buffer.
+  bool found = false;
+  int64_t stride = 0;
+  int64_t rows = 0;
+  if (data) {
+    const int64_t strides[] = {layout_.stride, RoundUpTo16(layout_.stride),
+                               width, RoundUpTo16(width)};
+    const int64_t row_counts[] = {RoundUpTo16(height), height};
+    // First an exact match, then any layout that fits.
+    for (int pass = 0; pass < 2 && !found; ++pass) {
+      for (int64_t candidate_rows : row_counts) {
+        for (int64_t candidate_stride : strides) {
+          if (candidate_stride < width || candidate_stride % 2 != 0 ||
+              candidate_rows < height || candidate_rows % 2 != 0) {
+            continue;
+          }
+          const int64_t needed = candidate_stride * candidate_rows * 3 / 2;
+          const bool matches =
+              pass == 0 ? needed == static_cast<int64_t>(data_size)
+                        : needed <= static_cast<int64_t>(data_size);
+          if (matches) {
+            stride = candidate_stride;
+            rows = candidate_rows;
+            found = true;
+            break;
+          }
+        }
+        if (found) {
+          break;
+        }
+      }
+    }
+  }
+
+  if (found) {
+    const int64_t chroma_stride = stride / 2;
+    const int64_t chroma_rows = rows / 2;
+    const uint8_t* y_plane = data;
+    const uint8_t* v_plane = data + stride * rows;
+    const uint8_t* u_plane = v_plane + chroma_stride * chroma_rows;
+    // |rows| and |stride| are even and not smaller than the picture, so the
+    // chroma planes hold at least |chroma_height| rows of |chroma_width|.
+    libyuv::CopyPlane(y_plane, static_cast<int>(stride),
+                      frame->writable_data(VideoFrame::Plane::kY),
+                      frame->stride(VideoFrame::Plane::kY), width, height);
+    libyuv::CopyPlane(u_plane, static_cast<int>(chroma_stride),
+                      frame->writable_data(VideoFrame::Plane::kU),
+                      frame->stride(VideoFrame::Plane::kU), chroma_width,
+                      chroma_height);
+    libyuv::CopyPlane(v_plane, static_cast<int>(chroma_stride),
+                      frame->writable_data(VideoFrame::Plane::kV),
+                      frame->stride(VideoFrame::Plane::kV), chroma_width,
+                      chroma_height);
+  }
+
+  media_buffer->Unlock();
+
+  if (!found) {
+    LOG(ERROR) << "Unexpected picture layout from the Windows H.264 decoder: "
+               << data_size << " bytes for " << layout_.size.ToString()
+               << ", stride " << layout_.stride;
+    return false;
+  }
+
+  frame->set_color_space(GuessColorSpace(config_, layout_.visible_rect.size()));
+  frame->metadata().power_efficient = false;
+
+  if (!logged_first_frame_) {
+    logged_first_frame_ = true;
+    MEDIA_LOG(INFO, media_log_)
+        << "MediaFoundationVideoDecoder: first picture decoded, "
+        << layout_.size.ToString() << ", shown "
+        << layout_.visible_rect.ToString();
+  }
+
+  output_cb_.Run(std::move(frame));
+  return true;
+}
+
+}  // namespace media
