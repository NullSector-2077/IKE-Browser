-bool PopulateInputSample(IMFSample* sample, const DecoderBuffer& input) {
+// I.K.E.: Media Source hands over AAC frames with an ADTS header in front
+// (see PrepareAACBuffer() in mp4_stream_parser.cc); a plain MP4 file gives the
+// bare frames. Returns the length of an ADTS header that covers the whole of
+// |data|, or 0 when there is none.
+size_t GetAdtsHeaderSize(const uint8_t* data, size_t size) {
+  constexpr size_t kMinAdtsHeaderSize = 7;
+  if (!data || size <= kMinAdtsHeaderSize) {
+    return 0;
+  }
+  // 12 bits of sync word, then one bit of version, two bits of layer (always
+  // 0) and the "no CRC" bit.
+  if (data[0] != 0xFF || (data[1] & 0xF6) != 0xF0) {
+    return 0;
+  }
+  const size_t header_size = (data[1] & 0x01) ? 7 : 9;
+  const size_t frame_length = (static_cast<size_t>(data[3] & 0x03) << 11) |
+                              (static_cast<size_t>(data[4]) << 3) |
+                              (static_cast<size_t>(data[5]) >> 5);
+  if (frame_length != size || header_size >= size) {
+    return 0;
+  }
+  return header_size;
+}
