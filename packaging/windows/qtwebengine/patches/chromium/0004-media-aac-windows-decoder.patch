+// I.K.E.: creates the AAC decoder of Windows straight from its library. This
+// needs neither the registry nor COM to be initialised on the calling thread,
+// which the enumeration below does; in Qt WebEngine the media service runs on
+// the in-process GPU thread, where COM is not initialised.
+Microsoft::WRL::ComPtr<IMFTransform> CreateWindowsAacDecoder() {
+  using DllGetClassObjectFunction = HRESULT(STDAPICALLTYPE*)(REFCLSID, REFIID,
+                                                             LPVOID*);
+  HMODULE library = GetMediaFoundationAacDecoderLibrary();
+  if (!library) {
+    return nullptr;
+  }
+  auto get_class_object = reinterpret_cast<DllGetClassObjectFunction>(
+      ::GetProcAddress(library, "DllGetClassObject"));
+  if (!get_class_object) {
+    return nullptr;
+  }
+  Microsoft::WRL::ComPtr<IClassFactory> factory;
+  HRESULT hr =
+      get_class_object(kWindowsAacDecoderClsid, IID_PPV_ARGS(&factory));
+  if (FAILED(hr) || !factory) {
+    return nullptr;
+  }
+  Microsoft::WRL::ComPtr<IMFTransform> transform;
+  hr = factory->CreateInstance(nullptr, IID_PPV_ARGS(&transform));
+  if (FAILED(hr)) {
+    return nullptr;
+  }
+  return transform;
+}
+#endif  // BUILDFLAG(USE_PROPRIETARY_CODECS)
