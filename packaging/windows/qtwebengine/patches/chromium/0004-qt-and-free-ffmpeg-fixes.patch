@@ -462,6 +464,19 @@ bool AVCodecContextToAudioDecoderConfig(const AVCodecContext* codec_context,
       sample_format = kSampleFormatMpegHAudio;
       break;
 #endif
+#if BUILDFLAG(ENABLE_PLATFORM_AAC_AUDIO)
