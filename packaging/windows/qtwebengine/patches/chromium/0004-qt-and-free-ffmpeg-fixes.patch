   DCHECK_EQ(av_get_bytes_per_sample(codec_context->sample_fmt),
diff --git a/chromium/media/filters/ffmpeg_demuxer.cc b/chromium/media/filters/ffmpeg_demuxer.cc
index 55143e96..b6b294a8 100644
--- a/chromium/media/filters/ffmpeg_demuxer.cc
+++ b/chromium/media/filters/ffmpeg_demuxer.cc
@@ -833,6 +833,22 @@ void FFmpegDemuxerStream::InitBitstreamConverter() {
       // ADTS anyways, so skip bitstream conversion when the profile is
       // unknown.
       // Also Windows need ADTS conversion for AAC
+#if BUILDFLAG(ENABLE_PLATFORM_AAC_AUDIO)
+      // I.K.E.: with ffmpeg_branding="Chromium" FFmpeg has neither an AAC
+      // decoder nor an AAC parser, so it leaves the profile unknown, and
+      // FFmpegAACBitstreamConverter cannot write an ADTS header without it.
+      // The profile is in the stream's AudioSpecificConfig: its first five
+      // bits are the audio object type, and FFmpeg numbers the AAC profiles
+      // as that type minus one (Main 1, LC 2, SSR 3, LTP 4, SBR 5, PS 29).
+      if (stream_->codecpar->profile == AV_PROFILE_UNKNOWN &&
+          stream_->codecpar->extradata &&
+          stream_->codecpar->extradata_size >= 2) {
+        const int object_type = stream_->codecpar->extradata[0] >> 3;
+        if ((object_type >= 1 && object_type <= 5) || object_type == 29) {
+          stream_->codecpar->profile = object_type - 1;
+        }
+      }
+#endif
       if (audio_config_->profile() != AudioCodecProfile::kXHE_AAC) {
         bitstream_converter_ =
             std::make_unique<FFmpegAACBitstreamConverter>(stream_->codecpar);
