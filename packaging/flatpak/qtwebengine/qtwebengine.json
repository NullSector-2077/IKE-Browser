{
    "//": "Qt WebEngine for the I.K.E. Flatpak, built over the one of the PyQt base application. Same source, patches and switches as Flathub's Qt WebEngine base application (io.qt.qtwebengine.BaseApp, branch 6.11, Qt 6.11.3), except: Chromium decodes through the FFmpeg of the run time (webengine_system_ffmpeg=ON), so H.264 and AAC play only where the run time's codec extension (org.freedesktop.Platform.codecs-extra) is installed; no OpenH264 is compiled in (rtc_use_h264=false, media_use_openh264=false: no H.264 encoding for WebRTC, MediaRecorder and WebCodecs); QtPdf is not built again (the base application's is kept; I.K.E. does not use it). The base application's Qt WebEngine libraries are removed before this one is installed, so none of their decoders stay in the bundle. ROADMAP.md, 'Codecs'; packaging/flatpak/README.md, 'Codecs'.",
    "name": "qt6-qtwebengine",
    "buildsystem": "cmake-ninja",
    "builddir": true,
    "build-options": {
        "append-path": "/usr/lib/sdk/node20/bin",
        "env": {
            "npm_config_nodedir": "/usr/lib/sdk/node20"
        },
        "no-debuginfo": true
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DQT_FEATURE_webengine_kerberos=ON",
        "-DQT_FEATURE_webengine_proprietary_codecs=ON",
        "-DQT_FEATURE_webengine_system_ffmpeg=ON",
        "-DQT_FEATURE_webengine_system_freetype=ON",
        "-DQT_FEATURE_webengine_system_icu=ON",
        "-DQT_FEATURE_webengine_system_libevent=ON",
        "-DQT_FEATURE_webengine_system_libxml=ON",
        "-DQT_FEATURE_webengine_webrtc_pipewire=ON",
        "-DQT_FEATURE_qtpdf_build=OFF",
        "-DQT_FEATURE_qtpdf_widgets_build=OFF",
        "-DQT_FEATURE_qtpdf_quick_build=OFF"
    ],
    "build-commands": [
        "sh ../remove-base-engine.sh"
    ],
    "post-install": [
        "ln -sfr ${FLATPAK_DEST}/lib/${FLATPAK_ARCH}-linux-gnu/libQt6WebEngine*.so* -t ${FLATPAK_DEST}/lib/",
        "ln -sfr ${FLATPAK_DEST}/lib/libexec/QtWebEngineProcess ${FLATPAK_DEST}/bin/QtWebEngineProcess"
    ],
    "sources": [
        {
            "type": "archive",
            "url": "https://download.qt.io/official_releases/qt/6.11/6.11.3/submodules/qtwebengine-everywhere-src-6.11.3.tar.xz",
            "mirror-urls": [
                "https://download.qt.io/archive/qt/6.11/6.11.3/submodules/qtwebengine-everywhere-src-6.11.3.tar.xz"
            ],
            "sha512": "c24f14c9b0b2c15614af89f74f7ea126bbb98e98e80c824cefbeb7be650f0cc226bb8e3bb60edf5fa2ef007c58fd6e19e45592d4fec72131a3c5dd657009e23d"
        },
        {
            "type": "shell",
            "commands": [
                "sed -i '/find_package(Qt6/ s/${PROJECT_VERSION}/${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}/' $(find . -name CMakeLists.txt)"
            ]
        },
        {
            "type": "patch",
            "paths": [
                "patches/qtwebengine-flatpak-paths.patch",
                "patches/flatpak-includedir-dbus.patch",
                "patches/qtwebengine-Disbale-xnnpack-on-aarch64.patch",
                "patches/qtwebengine-pipewire-screen.patch",
                "patches/qtwebengine-pipewire-camera.patch",
                "patches/qtwebengine-system-ffmpeg-without-first-dts.patch",
                "patches/qtwebengine-no-openh264.patch"
            ]
        },
        {
            "type": "patch",
            "paths": [
                "patches/chromium-add-app-libdir.patch",
                "patches/chromium-flatpak-add-initial-sandbox-support.patch",
                "patches/chromium-flatpak-adjust-paths-for-the-sandbox.patch",
                "patches/chromium-flatpak-expose-widevine-into-the-sandbox.patch",
                "patches/chromium-fix-gpu-crash.patch",
                "patches/chromium-system-ffmpeg-first-dts.patch"
            ],
            "options": [
                "--directory=src/3rdparty"
            ]
        },
        {
            "type": "script",
            "dest-filename": "remove-base-engine.sh",
            "commands": [
                "# runs after the build, before the install: the base application's Qt WebEngine",
                "# (Chromium's own FFmpeg with H.264 / AAC inside) must not stay in the bundle",
                "set -e",
                "lib=${FLATPAK_DEST}/lib/${FLATPAK_ARCH}-linux-gnu",
                "rm -fv $lib/libQt6WebEngine*.so* ${FLATPAK_DEST}/lib/libQt6WebEngine*.so*",
                "rm -fv ${FLATPAK_DEST}/lib/libexec/QtWebEngineProcess ${FLATPAK_DEST}/bin/QtWebEngineProcess"
            ]
        }
    ],
    "modules": [
        {
            "name": "python-html5lib",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"html5lib\" --no-build-isolation"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/77/c6/040cbc72480d789a5f40d63fb484d3106554c4dfa2d2b70ad5022057750f/webencodings-0.6.1-py3-none-any.whl",
                    "sha256": "7fab6269c8bf237c657876b52058ccb182e861518d1c695c1a9aaa8c1c105d5b",
                    "x-checker-data": {
                        "type": "pypi",
                        "name": "webencodings",
                        "packagetype": "bdist_wheel"
                    }
                },
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/6c/dd/a834df6482147d48e225a49515aabc28974ad5a4ca3215c18a882565b028/html5lib-1.1-py2.py3-none-any.whl",
                    "sha256": "0d78f8fde1c230e99fe37986a60526d7049ed4bf8a9fadbad5f00e22e58e041d",
                    "x-checker-data": {
                        "type": "pypi",
                        "name": "html5lib",
                        "packagetype": "bdist_wheel"
                    }
                },
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/b7/ce/149a00dd41f10bc29e5921b496af8b574d8413afcd5e30dfa0ed46c2cc5e/six-1.17.0-py2.py3-none-any.whl",
                    "sha256": "4721f391ed90541fddacab5acf947aa0d3dc7d27b2e1e8eda2be8970586c3274"
                }
            ],
            "cleanup": [
                "*"
            ]
        }
    ]
}
